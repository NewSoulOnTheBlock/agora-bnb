# Copy to .env and fill in. .env is gitignored at the repo root.
#
# NEVER paste a private key into chat, a commit message, or a shell command.
# Shell history persists commands; chat transcripts persist on disk. If a key
# has ever appeared in any of those, treat it as burned and move the funds.
#
# This file deliberately ships NO contract addresses pre-filled. An earlier
# version pre-filled AGORA_TOKEN with the v1 launch, which is permanently dead:
# its creator-fee recipient was pointed at a contract that cannot sweep, and the
# change was irreversible. Copying that default into a fresh .env silently wires
# tooling to a token whose fee stream can never be collected. Addresses now come
# from the deploy scripts' own output, which is the only source that can be
# right for the chain you are actually on.


# ===========================================================================
# Signing and RPC
# ===========================================================================

# Deploy-only key. Generate a FRESH one, fund it with just enough gas, and treat
# it as disposable — the deployer keeps no power over the Treasury once deployed
# (ownership goes to TREASURY_OWNER at construction).
#   cast wallet new
DEPLOYER_PRIVATE_KEY=

# Robinhood Chain (the live v2 deployment).
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_CHAIN_ID=4663

# BNB Chain. Test on bscTestnet first: Flap resolves its Portal and Guardian
# from a hardcoded chainid table, so 97 exercises the same code paths as 56.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545


# ===========================================================================
# Shared — both chains
# ===========================================================================

# Governance owner of the Treasury. SHOULD be a multisig or timelock.
# Left blank, the deploy scripts use the deployer EOA and print a prominent
# warning: a single EOA owning the collective balance sheet is exactly what
# spec §11's "no discretionary management" argues against. It also holds
# withdraw(), which is uncapped.
TREASURY_OWNER=

# Printed by deploy.ts (Robinhood) or deploy-bnb.ts (BNB). Read by almost every
# operational script: bind, collect-fees, distribute, withdraw, claim-yield,
# set-income-share, queue-adapter, repoint, preflight.
TREASURY=


# ===========================================================================
# Robinhood Chain — Pons fee path
# ===========================================================================
# The tax here is PULL-based: it accrues in the Pons hook, a Pons-controlled
# keeper sweeps it into the escrow, and only then can FeeSink claim it.

# Printed by deploy.ts. The address named as creatorFeeRecipient AT LAUNCH.
FEE_SINK=

# Printed by launch.ts. The AGORA token and its bonding curve.
TOKEN=
CURVE=

# Pons infrastructure, verified on chain 4663. Defaulted in the scripts; set
# only to override.
PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# The Suits ERC-721 (bind.ts). Robinhood Chain only — this collection has no
# BNB deployment, which is why the BNB build drops the Suits vault entirely.
SUITS_NFT=0x3ac7beb099c560f5a09bd822621327d8768f0625

# launch.ts — token metadata and launch parameters.
# CREATOR_TAX_BPS is 400 (4%) on Pons. Do not reuse this number on BNB: Flap
# permits 1/3/5/10% only, and AGORA launches there at 500.
TOKEN_NAME=
TOKEN_SYMBOL=
TOKEN_DESCRIPTION=
TOKEN_LOGO=
TOKEN_WEBSITE=
TOKEN_TWITTER=
TOKEN_TELEGRAM=
CREATOR_TAX_BPS=400
LAUNCH_CONFIG_ID=
LAUNCH_SALT=
# Dry run unless set to 1.
LAUNCH_EXECUTE=


# ===========================================================================
# BNB Chain — Flap fee path
# ===========================================================================
# The tax here is PUSH-based: Flap transfers it into AgoraVault and invokes
# receive() directly. No escrow, no claim(), no third-party keeper — which is
# the stall this port exists to remove.

# PancakeSwap V2 router. The vault sells the post-graduation tax leg here.
# V2, not V3: after DEX migration Flap pays the tax in AGORA itself, and AGORA
# is a tax token — so the swap needs the fee-on-transfer variant, which V3's
# exactInput does not provide.
PANCAKE_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E

# Flap VaultPortal (chain 56). deploy-bnb.ts echoes the launch call against it.
FLAP_VAULT_PORTAL=0x90497450f2a706f1951b5bdda52B4E5d16f34C06

# Printed by deploy-bnb.ts. Name this as `vaultFactory` in the Flap launch call.
VAULT_FACTORY=

# --- filled in AFTER the Flap launch, both required by bind-bnb.ts ---
# The token Flap created.
AGORA_TOKEN=
# The vault Flap's VaultPortal built from VAULT_FACTORY — read it from the
# VaultCreated event in the launch transaction. bind-bnb.ts verifies it pays
# THIS Treasury and is bound to THIS token before wiring anything.
AGORA_VAULT=

# --- printed by bind-bnb.ts; record them for later operations ---
STAKED_AGORA=
DISTRIBUTOR=
REDEEMER=


# ===========================================================================
# Operations
# ===========================================================================

# withdraw.ts — moves corpus ETH to the operator. Dry run unless EXECUTE=1.
# This is the one lever that LOWERS the redemption floor, and it is uncapped.
WITHDRAW_ETH=
WITHDRAW_EXECUTE=

# set-income-share.ts — share of tax earmarked for stakers, in bps. 3000 = 30%.
INCOME_SHARE_BPS=3000

# Beefy yield sleeve (Robinhood Chain): deploy-beefy-adapter, queue-adapter,
# rehearse-beefy.
ADAPTER=
CLM=
REWARD_POOL=
WETH=
# rehearse-beefy.ts only — size of the rehearsal deposit, in ether.
DEPOSIT=


# ===========================================================================
# Test-only flags (set on the command line, not here)
# ===========================================================================
#   BNB_TEST=1   run the in-process node as chain 56, so Flap's Portal and
#                Guardian resolve. Without it the BNB tests skip.
#   FORK=1       fork Robinhood Chain for the Beefy adapter tests.
#   FORK_BLOCK   pin the fork to a block for a reproducible run.
