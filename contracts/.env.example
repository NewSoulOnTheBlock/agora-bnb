# Copy to .env and fill in. .env is gitignored at the repo root.
#
# NEVER paste a private key into chat, a commit message, or a shell command.
# Shell history persists commands; chat transcripts persist on disk.

# Robinhood Chain mainnet
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_CHAIN_ID=4663

# Deploy-only key. Generate a FRESH one, fund it with just enough gas, and treat
# it as disposable — the deployer keeps no power over the Treasury once deployed.
#   cast wallet new
DEPLOYER_PRIVATE_KEY=

# The live AGORA token (verified on chain 4663).
AGORA_TOKEN=0x6853618673D952Fe602616F6f896cC7be8e25fCc

# Governance owner of the Treasury. SHOULD be a multisig or timelock.
# If this is left blank the deploy script uses the deployer EOA and prints a
# prominent warning — a single EOA owning the collective balance sheet is exactly
# what spec §11's "no discretionary management" lever argues against.
TREASURY_OWNER=
