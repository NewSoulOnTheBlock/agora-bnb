{
  "name": "agora-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cranks AGORA's permissionless maintenance calls. Holds no privileged key.",
  "scripts": {
    "once": "tsx src/run.ts --once",
    "start": "tsx src/run.ts",
    "live": "KEEPER_EXECUTE=1 tsx src/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
