# Copy to .env and fill in. .env is gitignored at the repo root.

RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_CHAIN_ID=4663

# The keeper's own key. Generate a FRESH one and fund it with gas only.
#   cast wallet new
#
# This key has NO privileges over the protocol. Every call the keeper makes is
# permissionless — anyone could make them. Losing this key costs you the gas
# left in the wallet and nothing else. Do NOT reuse the Treasury owner key.
KEEPER_PRIVATE_KEY=

# Nothing is sent unless this is 1. The default is a dry run that logs the
# decisions it would have made.
KEEPER_EXECUTE=0

# Seconds between passes.
KEEPER_INTERVAL=300

# Skip a job unless the value it moves is at least this many times the gas it
# costs. Prevents the keeper from spending 0.0002 ETH of gas to move 0.0001.
KEEPER_MIN_RATIO=3
